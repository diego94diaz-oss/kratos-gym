# Cloudflare Workers (assets estáticos) — encabezados de seguridad de Entrenamiento (2026-11-07).
# Mismo criterio que Mi Salud. Hay onclick en línea, por eso script-src lleva 'unsafe-inline'; connect-src
# limita a dónde se pueden mandar datos (Supabase, incluidas sus Edge Functions). Cámara permitida solo a la
# propia app (lector de códigos de barra). Si se agrega un servicio externo, sumarlo aquí.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://ivzzgeoeygggaoazcoeq.supabase.co; media-src 'self' blob:; connect-src 'self' https://ivzzgeoeygggaoazcoeq.supabase.co wss://ivzzgeoeygggaoazcoeq.supabase.co; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache
